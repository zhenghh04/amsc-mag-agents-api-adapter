# Copy to .env and fill in:   cp env.example .env
# .env is gitignored — never commit a real token.

# MAG (AMSC Model Access Gateway) OpenAI-compatible endpoint
MAG_BASE_URL=https://i2-api.genesis.american-science-cloud.org

# Your AMSC bearer token — paste as ONE unbroken line (no wrapping / no spaces /
# no backslashes; a line-wrapped paste corrupts the key and every call 302s).
MAG_API_KEY=

# Real sandbox executor (OpenAI OSS codex exec-server). Omit to disable the shell tool.
SANDBOX_URI=ws://127.0.0.1:8790

# Model the shim asks MAG to run (used by the example runner)
OPENAI_AGENTS_MODEL=gpt-5.3-codex

# Optional tuning
# SHIM_MAX_TURNS=10
